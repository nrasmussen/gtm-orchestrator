# ──────────────────────────────────────────────
# Notifications
# ──────────────────────────────────────────────
SLACK_WEBHOOK_URL=           # Incoming webhook URL for Slack alerts
DISCORD_WEBHOOK_URL=         # Incoming webhook URL for Discord alerts (optional)

# ──────────────────────────────────────────────
# CRM
# ──────────────────────────────────────────────
ATTIO_API_KEY=               # Attio API key (Settings > API keys)
HUBSPOT_TOKEN=               # HubSpot private app access token (optional)
AIRTABLE_TOKEN=              # Airtable personal access token
AIRTABLE_BASE_ID=            # ID of the target Airtable base (starts with "app")
APOLLO_API_KEY=              # Apollo.io API key (Settings > API)

# ──────────────────────────────────────────────
# Outbound
# ──────────────────────────────────────────────
LEMLIST_API_KEY=             # Lemlist API key (Settings > Integrations)
INSTANTLY_API_KEY=           # Instantly API key (optional)
SMARTLEAD_API_KEY=           # Smartlead API key (optional)
CLAY_WEBHOOK_URL=            # Clay inbound webhook URL for enrichment triggers

# ──────────────────────────────────────────────
# Content
# ──────────────────────────────────────────────
TYPEFULLY_API_KEY=           # Typefully API key for scheduling social drafts

# ──────────────────────────────────────────────
# Automation
# ──────────────────────────────────────────────
ZAPIER_WEBHOOK_URL=          # Zapier catch webhook URL (optional)
N8N_WEBHOOK_URL=             # n8n webhook URL (optional)
MAKE_WEBHOOK_URL=            # Make (Integromat) webhook URL (optional)

# ──────────────────────────────────────────────
# Data / Sheets
# ──────────────────────────────────────────────
GOOGLE_SHEETS_API_KEY=       # Google API key with Sheets API enabled (Cloud Console > APIs & Services > Credentials)
GOOGLE_SHEETS_SPREADSHEET_ID=  # Spreadsheet ID from its URL, between /d/ and /edit (optional)

# ──────────────────────────────────────────────
# General
# ──────────────────────────────────────────────
DRY_RUN=                     # Set to 1 to test without sending any requests (optional)
